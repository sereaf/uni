{"cell_type":"code","end":1727795214878,"exec_count":6,"id":"dc8a6f","input":"import time\n\ndef gcd_w_factor(a,b):\n    af = factor(a)\n    bf = factor(b)\n    GCM = {}\n    a_primes = [prime for prime, exp in af]\n    b_primes = [prime for prime, exp in bf]\n    com_primes = set([prime for prime in a_primes+b_primes if prime in a_primes and prime in b_primes])\n\n    GCD = {}\n    for f in [af, bf]:\n        for prime, exp in f:\n            if prime in com_primes:\n                if prime in GCD:\n                    GCD[prime] = min(GCD[prime], exp)\n                else:\n                    GCD[prime] = exp\n\n    n = 1\n    for k, v in GCD.items():\n        n *= k^v\n    return n\n\ndef gcd_w_eukl(a,b):\n    if b == 0:\n        return a\n    return gcd_w_eukl(b, a % b)\n\n\ndata = []\nfor i in range(5,20+1):\n    runtime_of_euc_gcd = 0\n    runtime_of_fac_gcd = 0\n    for j in range(10):\n        a = randint(10^i,10^(i+1))\n        b = randint(10^i,10^(i+1))\n        c = gcd(a,b)\n        start = time.time()\n        assert gcd_w_eukl(a,b) == c\n        runtime_of_euc_gcd += time.time() - start\n        start = time.time()\n        assert gcd_w_factor(a,b) == c\n        runtime_of_fac_gcd += time.time() - start\n    runtime_of_euc_gcd /= 10\n    runtime_of_fac_gcd /= 10\n    data.append([i,runtime_of_euc_gcd,runtime_of_fac_gcd])\n\nplot1 = point([(d[0],d[1]) for d in data],color=\"red\", legend_label=\"Eucl\")\nplot2 = point([(d[0],d[2]) for d in data], legend_label=\"Factor\")\nshow(plot1+plot2)","kernel":"sage-10.4","output":{"0":{"data":{"image/png":"ac5847a214229577b180b9060c6c119cf0db7c7c","text/plain":"Graphics object consisting of 2 graphics primitives"}}},"pos":15,"start":1727795213860,"state":"done","type":"cell"}
{"cell_type":"code","end":1728061336173,"exec_count":3,"id":"922740","input":"def binary_gcd(a, b):\n    if a == 0:\n        return b\n    elif b == 0:\n        return a\n    \n    shift = 0\n    while (a | b) & 1 == 0:\n        a >>= 1\n        b >>= 1\n        shift += 1\n       \n    while a & 1 == 0:\n        a >>= 1\n\n    while b != 0:\n        while b & 1 == 0:\n            b >>= 1\n    \n        if a > b:\n            a, b = b, a\n        b = b - a\n        \n    return a << shift\n\nprint(gcd(48, 28))\nprint(binary_gcd(48, 28))","kernel":"sage-10.4","output":{"0":{"name":"stdout","text":"4\n4\n"}},"pos":17,"start":1728061336112,"state":"done","type":"cell"}
{"cell_type":"code","end":1728223666887,"exec_count":2,"id":"027d82","input":"def gcd_extended(a, b):        \n    if a == 0:\n        return b, 0, 1\n    gcd, x1, y1 = gcd_extended(b % a, a)\n    x = y1 - (b // a) * x1\n    y = x1\n    return gcd, x, y\n\nprint(xgcd(25, 12))\nprint(gcd_extended(25, 12))","kernel":"sage-10.4","output":{"0":{"name":"stdout","text":"(1, 1, -2)\n(1, 1, -2)\n"}},"pos":19,"start":1728223666884,"state":"done","type":"cell"}
{"cell_type":"code","end":1728227551016,"exec_count":4,"id":"e35c67","input":"def binary_xgcd(a, b):\n    if a == 0:\n        return b, 0, 1\n    elif b == 0:\n        return a, 1, 0\n    \n    shift = 0\n    while (a | b) & 1 == 0:\n        a >>= 1\n        b >>= 1\n        shift += 1\n        \n    u, v = a, b\n    u_coeff, v_coeff = 1, 0\n    u_coeff_b, v_coeff_b = 0, 1\n    \n    while u != 0 and v != 0:\n        while u & 1 == 0:\n            u >>= 1\n            if u_coeff & 1 == 0 and v_coeff & 1 == 0:\n                u_coeff >>= 1\n                v_coeff >>= 1\n            else:\n                u_coeff = (u_coeff + b) >> 1\n                v_coeff = (v_coeff - a) >> 1\n\n        while v & 1 == 0:\n            v >>= 1\n            if u_coeff_b & 1 == 0 and v_coeff_b & 1 == 0:\n                u_coeff_b >>= 1\n                v_coeff_b >>= 1\n            else:\n                u_coeff_b = (u_coeff_b + b) >> 1\n                v_coeff_b = (v_coeff_b - a) >> 1\n\n        if u >= v:\n            u -= v\n            u_coeff -= u_coeff_b\n            v_coeff -= v_coeff_b\n        else:\n            v -= u\n            u_coeff_b -= u_coeff\n            v_coeff_b -= v_coeff\n            \n    if u == 0:\n        return v << shift, u_coeff_b, v_coeff_b\n    else:\n        return u << shift, u_coeff, v_coeff\n    \nprint(xgcd(48, 28))\nprint(binary_xgcd(48, 28))","kernel":"sage-10.4","output":{"0":{"name":"stdout","text":"(4, 3, -5)\n(4, 3, -5)\n"}},"pos":21,"start":1728227550611,"state":"done","type":"cell"}
