{"end":1729508673039,"exec_count":21,"id":"8d0bbf","input":"def crt1(C, M):\n#     m1x + m2y = 1 -> c = m1 x c2 + m2 y c1 == x mod m1 m2\n    Mall = prod(M)\n    xall = 0\n    for ci, mi in zip(C,M):\n        Mi = Mall//mi\n        z = inverse_mod(Mi, mi)\n        xall += Mi*z*ci\n    return xall % Mall\n\nC = [2, 3, 4]\nM  = [3,4,5]\ncrt(C,M) == crt1(C,M)","kernel":"sage-10.4","output":{"0":{"data":{"text/plain":"True"},"exec_count":21}},"pos":2,"start":1729508673020,"state":"done","type":"cell"}
